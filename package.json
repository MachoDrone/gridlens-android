{
  "name": "gridlens-android",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "description": "Independent Android distribution of GridLens with the original Fleet UI and on-device public data runtime",
  "license": "MIT",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "deps:vendor": "npm ci --ignore-scripts --prefix vendor/gridlens",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-runtime.ts",
    "native:prepare": "node tools/prepare-native.ts",
    "test": "node --test test/*.test.ts",
    "check:vendor": "npm run check --prefix vendor/gridlens",
    "check": "npm run typecheck && npm run build && npm test && npm run test:collector && npm run check:vendor",
    "test:collector": "python3 -B -m unittest discover -s test -p 'test_*collector.py' -v"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
