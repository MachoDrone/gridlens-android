#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${JAVA_HOME:-}" ]; then
    GRIDLENS_JAVA="$JAVA_HOME/bin/java"
else
    GRIDLENS_JAVA=java
fi
exec "$GRIDLENS_JAVA" -classpath "$SCRIPT_DIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
